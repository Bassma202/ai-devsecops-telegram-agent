# Copy to .env (never commit .env to version control)
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token
# Comma-separated numeric Telegram user IDs authorized to run FORGE commands (default-deny when empty)
FORGE_ALLOWED_TELEGRAM_USER_IDS=123456789
# Optional comma-separated allowed chat IDs
FORGE_ALLOWED_TELEGRAM_CHAT_IDS=
FORGE_DB_PATH=data/forge.db
